{
	"dependencies": {
		"@aws-sdk/client-eventbridge": "3.1049.0",
		"@aws-sdk/client-sqs": "3.1049.0",
		"@fastify/static": "9.1.3",
		"@nestjs/common": "11.1.27",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.1.27",
		"@nestjs/microservices": "11.1.27",
		"@nestjs/platform-fastify": "11.1.27",
		"@nestjs/schedule": "6.1.3",
		"@nestjs/swagger": "11.4.5",
		"@scalar/nestjs-api-reference": "1.2.8",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"dd-trace": "5.103.0",
		"drizzle-orm": "0.45.2",
		"fastify": "5.10.0",
		"pg": "8.22.0",
		"pino": "10.3.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"uuid": "14.0.1"
	},
	"description": "Boilerplate for NestJS projects",
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@nestjs/cli": "11.0.23",
		"@nestjs/schematics": "11.1.0",
		"@swc/core": "1.15.43",
		"@types/node": "25.9.0",
		"@types/pg": "8.20.0",
		"@vitest/coverage-v8": "4.1.10",
		"dependency-cruiser": "17.4.0",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"husky": "9.1.7",
		"knip": "6.25.0",
		"pino-pretty": "13.1.3",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"name": "@org/api",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"arch": "depcruise src",
		"arch:graph": "depcruise src --output-type dot | dot -T svg > dependency-graph.svg",
		"build": "nest build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dead": "knip",
		"dev": "nest start --watch",
		"docker:up": "docker compose up -d",
		"openapi:export": "NODE_ENV='openapi' nest build && node dist/src/composition-root/openapi-export.command.js",
		"prepare": "husky",
		"start": "nest start",
		"start:prod": "nest start:prod",
		"test": "vitest run",
		"tsc": "tsc --noEmit"
	},
	"version": "1.0.0"
}
