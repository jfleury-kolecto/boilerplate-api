# --- Runtime ---

# One of: local | development | production | test | openapi.
NODE_ENV="local"

# HTTP port for the API (src/api.ts). Defaults to 3000 if unset.
PORT="3000"

# --- Database ---

# PostgreSQL connection string consumed by Drizzle (src/core/database).
DATABASE_URL="postgresql://admin:password@localhost:5432/postgres"

# --- Outbox relay + EventBridge ---

# Name of the EventBridge bus domain events are published to via PutEvents.
# Required — the app fails fast on startup when empty. Locally: provisioned
# by docker/localstack-init/02-init-eventbridge.sh.
EVENT_BUS_NAME="boilerplate-bus"

# AWS region the EventBridge / SQS clients connect to.
AWS_REGION="eu-west-1"

# Override the EventBridge endpoint. Set for LocalStack; leave empty in
# prod so the SDK uses the real AWS endpoint.
AWS_ENDPOINT_URL_EVENTS="http://localhost:4566"

# --- Notification consumer ---

# URL of the SQS queue the notification bounded context long-polls. The
# EventBridge rule in 02-init-eventbridge.sh wires it as the target.
NOTIFICATION_QUEUE_URL="http://localhost:4566/000000000000/notification-emails"

# Override the SQS endpoint for the consumer. Set for LocalStack; leave
# empty in prod.
AWS_ENDPOINT_URL_SQS="http://localhost:4566"

# Credentials. LocalStack accepts any value, prod relies on the IAM
# role attached to the task — leave these unset in prod to let the SDK
# default provider chain pick them up.
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Relay tick interval in milliseconds. Defaults to 5000.
# The API exposes GET /healthz which returns 200 when the relay
# ticked within the last 2× this interval, 503 otherwise.
OUTBOX_RELAY_INTERVAL_MS="5000"

# --- Observability ---

# Surfaced as the Datadog "version" tag. Typically the git SHA or the
# package version. dd-trace is skipped when NODE_ENV is local or test.
APP_VERSION=""
